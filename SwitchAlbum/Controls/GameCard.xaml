<UserControl x:Class="SwitchAlbum.Controls.GameCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:SwitchAlbum.Resources"
             xmlns:conv="clr-namespace:SwitchAlbum.Converters"
             xmlns:vm="clr-namespace:SwitchAlbum.ViewModels"
             Width="218" Height="204">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:InverseBooleanConverter x:Key="InvertBool"/>
        <conv:FileImageConverter x:Key="FileImage"/>
    </UserControl.Resources>
    <Border x:Name="Root" Background="{DynamicResource SurfaceBrush}" CornerRadius="14"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"
            MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave"
            MouseLeftButtonDown="Root_MouseLeftButtonDown"
            ContextMenuService.IsEnabled="{Binding IsAllCard, Converter={StaticResource InvertBool}}">
        <Border.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="{x:Static res:Strings.Cover_Change}" Command="{Binding ChangeCoverCommand}"/>
                <MenuItem Header="{x:Static res:Strings.Cover_Reset}" Command="{Binding ResetCoverCommand}"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" CenterX="109" CenterY="102"/>
        </Border.RenderTransform>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="104"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>

            <!-- 封面 -->
            <Border Width="92" Height="92" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                    ClipToBounds="True"
                    Visibility="{Binding IsAllCard, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <Grid>
                    <Rectangle Fill="{DynamicResource PlaceholderBrush}"/>
                    <Image Source="{Binding CoverPath, Converter={StaticResource FileImage}}" Stretch="UniformToFill"/>
                    <TextBlock Text="{x:Static res:Strings.Cover_Unknown}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding CoverPath, Converter={StaticResource NullToVis}}"/>
                </Grid>
            </Border>

            <!-- 「全部」卡片的图标：叠影圆角方块 -->
            <Grid Width="92" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding IsAllCard, Converter={StaticResource BoolToVis}}">
                <Border Width="72" Height="72" CornerRadius="14" Background="{DynamicResource PurpleSoftBrush}" RenderTransformOrigin="0.5,0.5"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,12,0">
                    <Border.RenderTransform>
                        <RotateTransform Angle="-8"/>
                    </Border.RenderTransform>
                </Border>
                <Border Width="72" Height="72" CornerRadius="14" Background="{DynamicResource SurfaceHoverBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,0,8">
                    <TextBlock Text="{x:Static res:Strings.Card_AllGames}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>
            </Grid>

            <!-- 更换封面：鼠标移到卡片上才出现（右键卡片是同一个菜单） -->
            <Button x:Name="CoverButton" Content="✎" ToolTip="{x:Static res:Strings.Cover_Change}" Click="CoverButton_Click"
                    Width="26" Height="26" Padding="0" FontSize="13" FontFamily="Segoe UI Symbol"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Root}" Value="True"/>
                                    <Condition Binding="{Binding IsAllCard}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 标题 -->
            <TextBlock Grid.Row="1" Text="{Binding Title}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"
                       FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top"/>

            <!-- 副标题 -->
            <TextBlock Grid.Row="2" Text="{Binding Subtitle}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
