<UserControl x:Class="SwitchAlbum.Views.GameGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:SwitchAlbum.Resources"
             xmlns:controls="clr-namespace:SwitchAlbum.Controls"
             xmlns:vm="clr-namespace:SwitchAlbum.ViewModels">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Padding="18,0,18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="{x:Static res:Strings.Btn_Back}"
                        Command="{Binding DataContext.BackToWallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource SubtleButtonStyle}" Padding="12,6" FontSize="12"/>

                <!-- 游戏名可能很长：过长时省略，不再压到右边的按钮上 -->
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="14,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedText}" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="18,0,0,0" FontSize="12.5"/>

                    <!-- 拍摄时间排序 -->
                    <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center" Margin="16,0,12,0"/>
                    <Button Content="{x:Static res:Strings.Sort_NewestFirst}" Command="{Binding SortNewestFirstCommand}"
                            ToolTip="{x:Static res:Strings.Sort_Tooltip}" Padding="10,5" FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNewestFirst}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{x:Static res:Strings.Sort_OldestFirst}" Command="{Binding SortOldestFirstCommand}"
                            ToolTip="{x:Static res:Strings.Sort_Tooltip}" Padding="10,5" FontSize="12" Margin="6,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNewestFirst}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 预览大小 -->
                    <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center" Margin="12,0"/>
                    <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{x:Static res:Strings.Zoom_Tooltip}">
                        <TextBlock Text="{x:Static res:Strings.Zoom_Small}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Slider Width="92" Margin="8,0" Minimum="0" Maximum="{x:Static vm:PhotoGridLayout.ZoomSliderMaximum}"
                                TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                Value="{Binding ZoomLevel}" Style="{StaticResource ZoomSliderStyle}"/>
                        <TextBlock Text="{x:Static res:Strings.Zoom_Large}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Content="{x:Static res:Strings.Btn_SelectUnsaved}"
                            Command="{Binding DataContext.SelectUnsavedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource SubtleButtonStyle}" Padding="10,5" FontSize="12"/>
                    <Button Content="{x:Static res:Strings.Btn_SelectAll}"
                            Command="{Binding DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource SubtleButtonStyle}" Padding="10,5" FontSize="12" Margin="8,0,0,0"/>
                    <Button Content="{x:Static res:Strings.Btn_DeselectAll}"
                            Command="{Binding DataContext.DeselectAllCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource SubtleButtonStyle}" Padding="10,5" FontSize="12" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 照片网格（行分块 + ListBox 虚拟化） -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 Padding="14,0,14,18" x:Name="GridList" SizeChanged="GridList_SizeChanged"
                 PreviewMouseWheel="GridList_PreviewMouseWheel" ScrollViewer.ScrollChanged="GridList_ScrollChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:PhotoCard Margin="4"
                                                    CardWidth="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
