<Window x:Class="SwitchAlbum.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:SwitchAlbum.Resources"
        xmlns:controls="clr-namespace:SwitchAlbum.Controls"
        xmlns:views="clr-namespace:SwitchAlbum.Views"
        xmlns:vm="clr-namespace:SwitchAlbum.ViewModels"
        xmlns:conv="clr-namespace:SwitchAlbum.Converters"
        Title="{x:Static res:Strings.App_Title}"
        Width="1280" Height="800" MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanConverter x:Key="InvertBool"/>
        <DataTemplate DataType="{x:Type vm:GameWallViewModel}">
            <views:GameWallView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameGridViewModel}">
            <views:GameGridView/>
        </DataTemplate>
    </Window.Resources>

    <!--
        布局：顶栏选「从哪里看」（来源），底部操作栏选「送到哪里」（去处）。
        ┌ 标题 · 设备状态 ─── [Switch 相册][电脑里的照片] ─── 刷新 · 设置 ┐
        │ 游戏墙 / 照片网格                                              │
        ├ 已选 N 项 · 保存位置      [存到电脑][存到安卓手机][发送到 iPhone] ┤
        └ 轻提示                         进度 · 速度 · 剩余时间 · 取消     ┘
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶栏：来源 ============ -->
        <Border Grid.Row="0" Background="{DynamicResource TopBarBackgroundBrush}" Padding="18,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:Strings.App_Title}" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <!-- 设备状态 -->
                    <Border Margin="14,0,0,0" CornerRadius="11" Padding="12,5"
                            Background="{DynamicResource ChipBackgroundBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource DeviceDotOffBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource DeviceDotBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="7,0,0,0" Text="{Binding DeviceStatusText}" FontSize="12.5" MaxWidth="200"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceStatusText}"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 来源分段标签：紫色胶囊在两个标签之间滑动 -->
                <Border Grid.Column="1" Background="{DynamicResource ChipBackgroundBrush}" CornerRadius="11" Padding="3"
                        VerticalAlignment="Center" IsEnabled="{Binding IsTransferring, Converter={StaticResource InvertBool}}">
                    <Grid>
                        <Border x:Name="TabIndicator" Background="{DynamicResource PurpleBrush}" CornerRadius="9"
                                HorizontalAlignment="Left" Width="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TabIndicatorShift"/>
                            </Border.RenderTransform>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SwitchTab" Content="{x:Static res:Strings.Tab_SwitchAlbum}" Command="{Binding ShowSwitchSourceCommand}"
                                    Tag="{Binding IsSwitchSource}" Style="{StaticResource SegmentTabStyle}"/>
                            <Button x:Name="LibraryTab" Content="{x:Static res:Strings.Tab_Library}" Command="{Binding ShowLibrarySourceCommand}"
                                    Tag="{Binding IsLibrarySource}" Style="{StaticResource SegmentTabStyle}" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="{x:Static res:Strings.Btn_Refresh}" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SubtleButtonStyle}"/>
                    <Button Content="{x:Static res:Strings.Btn_Settings}" Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource SubtleButtonStyle}" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 内容区 ============ -->
        <Grid Grid.Row="1">
            <controls:TransitionHost x:Name="ContentHost" Content="{Binding CurrentContent}"/>

            <!-- 空状态：安静的月夜远山 + 提示文字（标题随状态变化：未连接 / 相册为空 / 电脑里没有照片 / 正在扫描） -->
            <controls:EmptyScene Visibility="{Binding HintVisible, Converter={StaticResource BoolToVis}}"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640" Margin="0,0,0,120"
                        Visibility="{Binding HintVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding HintTitle}" TextWrapping="Wrap" TextAlignment="Center"
                           FontSize="24" FontWeight="Light" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding HintText}" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="22" Margin="0,14,0,0"
                           MaxWidth="560"/>
            </StackPanel>

            <!-- ============ 灯箱浮层 ============ -->
            <Grid Background="{DynamicResource OverlayBrush}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Lightbox}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                             Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Button Content="‹" Command="{Binding Lightbox.PrevCommand}" IsEnabled="{Binding Lightbox.CanPrev}"
                        Style="{StaticResource LightboxButtonStyle}" FontSize="52" Width="72" Height="120"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Content="›" Command="{Binding Lightbox.NextCommand}" IsEnabled="{Binding Lightbox.CanNext}"
                        Style="{StaticResource LightboxButtonStyle}" FontSize="52" Width="72" Height="120"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="×" Command="{Binding Lightbox.CloseCommand}"
                        Style="{StaticResource LightboxButtonStyle}" FontSize="26" Width="46" Height="46"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"/>

                <Grid Margin="96,40,96,88">
                    <Image x:Name="LightboxImage" Source="{Binding Lightbox.FullPath}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="LightboxScale"/>
                        </Image.RenderTransform>
                    </Image>

                    <!-- 视频占位 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Lightbox.Current.IsVideo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Static res:Strings.Lightbox_NoPreview}" Foreground="#CCFFFFFF"
                                   FontSize="14" HorizontalAlignment="Center"/>
                        <Button Content="{x:Static res:Strings.Btn_OpenVideo}" Command="{Binding Lightbox.OpenVideoCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 底部信息条 -->
                <Border Background="#66000000" CornerRadius="10" Padding="16,8"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Lightbox.IndexText}" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  " Foreground="#99FFFFFF" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Lightbox.CaptionText}" Foreground="#DDFFFFFF" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 操作栏：去处 ============ -->
        <Border Grid.Row="2" Background="{DynamicResource TopBarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActionSummary}" VerticalAlignment="Center" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanAct}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 保存位置（Switch 来源时显示，「存到电脑」的目的地） -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"
                                Visibility="{Binding IsSwitchSource, Converter={StaticResource BoolToVis}}">
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource BorderBrush}" Margin="0,0,16,0"/>
                        <TextBlock Text="{x:Static res:Strings.Lbl_SaveTo}" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SavePathText}" VerticalAlignment="Center" MaxWidth="220" FontSize="12"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding SavePathText}"/>
                        <Button Content="{x:Static res:Strings.Btn_ChangePath}" Command="{Binding ChangeSavePathCommand}"
                                Style="{StaticResource SubtleButtonStyle}" Margin="8,0,0,0" Padding="10,4" FontSize="12"/>
                    </StackPanel>

                    <!-- 电脑来源：打开保存文件夹 -->
                    <Button Content="{x:Static res:Strings.Btn_OpenSaveFolder}" Command="{Binding OpenSaveFolderCommand}"
                            Style="{StaticResource SubtleButtonStyle}" Margin="20,0,0,0" Padding="10,4" FontSize="12"
                            Visibility="{Binding IsLibrarySource, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{x:Static res:Strings.Action_SaveToPc}" Command="{Binding SaveToPcCommand}"
                            IsEnabled="{Binding CanSaveToPc}" ToolTip="{Binding SaveToPcTooltip}"
                            ToolTipService.ShowOnDisabled="True"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="18,8"
                            Visibility="{Binding IsSwitchSource, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{x:Static res:Strings.Action_SaveToAndroid}" Command="{Binding SaveToAndroidCommand}"
                            IsEnabled="{Binding CanSendToPhone}" ToolTip="{x:Static res:Strings.Action_AndroidTip}"
                            ToolTipService.ShowOnDisabled="True"
                            Style="{StaticResource DestinationButtonStyle}" Margin="10,0,0,0"/>
                    <Button Content="{x:Static res:Strings.Action_SendToIphone}" Command="{Binding SendToIphoneCommand}"
                            IsEnabled="{Binding CanSendToPhone}" ToolTip="{x:Static res:Strings.Action_IphoneTip}"
                            ToolTipService.ShowOnDisabled="True"
                            Style="{StaticResource DestinationButtonStyle}" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="3" Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,7">
            <Grid MinHeight="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 轻提示 -->
                <Border CornerRadius="10" Background="{DynamicResource ToastBackgroundBrush}" Padding="14,5"
                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,16,0"
                        BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1"
                        Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <!-- 轻提示从下方浮上来 -->
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="10" To="0" Duration="0:0:0.42">
                                                    <DoubleAnimation.EasingFunction>
                                                        <ExponentialEase EasingMode="EaseOut" Exponent="5"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ToastText}" Foreground="White" FontSize="12.5" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ToastText}"/>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="560"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressText}"/>
                    <ProgressBar Width="200" Style="{StaticResource ThinProgressBarStyle}" Value="{Binding ProgressValue}"
                                 Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}"/>
                    <ProgressBar Width="200" Style="{StaticResource ThinProgressBarStyle}" IsIndeterminate="True"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{x:Static res:Strings.Btn_Cancel}" Command="{Binding CancelTransferCommand}"
                            Style="{StaticResource SubtleButtonStyle}" Margin="12,0,0,0" Padding="10,4" FontSize="12"
                            Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{x:Static res:Strings.Btn_OpenFolder}" Command="{Binding OpenLastOutputCommand}"
                            Style="{StaticResource SubtleButtonStyle}" Margin="12,0,0,0" Padding="10,4" FontSize="12"
                            Visibility="{Binding HasLastOutput, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
