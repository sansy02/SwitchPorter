<Window x:Class="SwitchAlbum.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:SwitchAlbum.Resources"
        Title="{x:Static res:Strings.Dlg_Settings_Title}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="26,22,26,20">
        <!-- 保存位置 -->
        <TextBlock Text="{x:Static res:Strings.Lbl_SavePath}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,7" VerticalAlignment="Center">
                <TextBlock Text="{Binding SavePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SavePath}"/>
            </Border>
            <Button Grid.Column="1" Content="{x:Static res:Strings.Btn_ChangePath}" Click="ChangePath_Click"
                    Style="{StaticResource SubtleButtonStyle}" Margin="10,0,0,0" Padding="12,6" FontSize="12"/>
        </Grid>

        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,18"/>

        <!-- 自动重命名 -->
        <CheckBox Content="{x:Static res:Strings.Settings_AutoRename}" IsChecked="{Binding AutoRename}"/>
        <TextBlock Text="{x:Static res:Strings.Settings_AutoRenameExample}" FontSize="11.5"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="26,5,0,0"/>

        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,18"/>

        <!-- 主题 -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Settings_Theme}" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding ThemeOption}"/>
        </Grid>

        <!-- 手机目标设备 -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static res:Strings.Settings_PhoneDevice}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Phones}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedPhone}"/>
            <Button Grid.Column="2" Content="{x:Static res:Strings.Phone_Refresh}" Command="{Binding RefreshPhonesCommand}"
                    Style="{StaticResource SubtleButtonStyle}" Margin="10,0,0,0" Padding="12,6" FontSize="12"/>
        </Grid>

        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,18"/>

        <!-- 数据管理 -->
        <StackPanel Orientation="Horizontal">
            <Button Content="{x:Static res:Strings.Btn_OpenSaveFolder}" Command="{Binding OpenSaveFolderCommand}"
                    Style="{StaticResource SubtleButtonStyle}" Padding="12,6" FontSize="12"/>
            <Button Content="{x:Static res:Strings.Btn_ClearCache}" Command="{Binding ClearCacheCommand}"
                    Style="{StaticResource SubtleButtonStyle}" Padding="12,6" FontSize="12" Margin="10,0,0,0"/>
            <TextBlock Text="{Binding CacheSizeText}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="{Binding CacheStatus}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- 已保存记录 -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{x:Static res:Strings.Btn_ClearSaved}" Command="{Binding ClearSavedRecordsCommand}"
                    Style="{StaticResource SubtleButtonStyle}" Padding="12,6" FontSize="12"/>
            <TextBlock Text="{Binding SavedCountText}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,18"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static res:Strings.Btn_OpenLogs}" Command="{Binding OpenLogsCommand}"
                    Style="{StaticResource SubtleButtonStyle}" Margin="0,0,10,0" Padding="12,6" FontSize="12"/>
            <Button Content="{x:Static res:Strings.Settings_Close}" Click="Close_Click"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="96"/>
        </StackPanel>
    </StackPanel>
</Window>
